# Content-only skill image for Kubernetes image volume mounts.
#
# The operator mounts this image as a read-only volume into the sandbox pod
# at /app/skills/rds-policy-update/ via the AgenticRun tools.skills[] spec:
#
#   tools:
#     skills:
#     - image: <registry>/rds-policy-skill:latest
#       paths: ["/skills/rds-policy-update"]
#
# Build:
#   podman build -f Containerfile -t rds-policy-skill:latest .

FROM scratch

COPY skills/rds-policy-update/ /skills/rds-policy-update/

LABEL name="rds-policy-skill" \
      summary="RDS Policy Update skill image for OpenShift Lightspeed" \
      description="Content-only OCI image carrying the rds-policy-update skill at /skills/rds-policy-update for K8s image volume mounts"
